  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Fintech Ledger & Transfer Throughput",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Transfer & Deposit Throughput (ops/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(wallet_transfers_count_total[1m])) by (type, status)",
          "legendFormat": "{{type}} - {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Transfer Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "wallet_transfers_duration_seconds{quantile=\"0.5\", type=\"transfer\"}",
          "legendFormat": "p50 (median)"
        },
        {
          "expr": "wallet_transfers_duration_seconds{quantile=\"0.95\", type=\"transfer\"}",
          "legendFormat": "p95"
        },
        {
          "expr": "wallet_transfers_duration_seconds{quantile=\"0.99\", type=\"transfer\"}",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Database Connection Pool (HikariCP) & System Health",
      "type": "row"
    },
    {
      "id": 3,
      "title": "HikariCP Connection Pool Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active Connections"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "Idle Connections"
        },
        {
          "expr": "hikaricp_connections_max",
          "legendFormat": "Max Connections Pool"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "Pending Threads Waiting for Conn"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Used Heap"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Max Heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "unit": "bytes"
        }
      }
    }
