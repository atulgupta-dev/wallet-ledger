# ==============================================================================
# Wallet & Ledger Engine - Zero-Cost Cloud Deployment Configuration
# Compatible with Render / Koyeb / Railway + Neon PostgreSQL + Upstash Redis
# ==============================================================================

# Server Port (Render/Koyeb injects $PORT dynamically)
PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL (e.g. Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full JDBC URL (from Neon console; append ?sslmode=require)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# Option B: Individual host/port parameters (used by default with local Docker Postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wallet_ledger
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Redis (e.g. Upstash Serverless Redis)
# ------------------------------------------------------------------------------
# Option A: Upstash Host / Port / Password with TLS
SPRING_DATA_REDIS_HOST=your-instance.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_upstash_password_here
REDIS_SSL=true

# Option B: Redis URL
# SPRING_DATA_REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# ------------------------------------------------------------------------------
# Kafka Feature Toggle (Optional for Free-Tier Cloud Containers)
# ------------------------------------------------------------------------------
# Set to false to run completely without a Kafka broker on free-tier containers
APP_KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
